# HTTPS reverse proxy for OpenCTI.
# OPENCTI_HOST and CADDY_TLS come from .env (via docker-compose.yml).
#   CADDY_TLS=<email>   -> public certificate from Let's Encrypt (host must resolve publicly, ports 80/443 open)
#   CADDY_TLS=internal  -> certificate from Caddy's own CA (private networks, IPs, localhost)

{
	# Don't try to install the internal CA into the container's trust store.
	skip_install_trust
}

{$OPENCTI_HOST} {
	tls {$CADDY_TLS}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy opencti:8080 {
		# Stream responses immediately (live streams / server-sent events).
		flush_interval -1
	}
}
