# Copy to .env, or run ./setup.sh to generate .env with random secrets.
# Every value marked CHANGEME must be replaced before first start.

COMPOSE_PROJECT_NAME=opencti
OPENCTI_VERSION=7.260921.0

###########################
# DEPENDENCIES            #
###########################

MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGEME
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGEME
# Elasticsearch heap. Use about half of the RAM you give Elasticsearch, max 31G.
ELASTIC_MEMORY_SIZE=4G
SMTP_HOSTNAME=localhost
SMTP_PORT=25

###########################
# OPENCTI                 #
###########################

# Hostname (or IP) users type in their browser. OpenCTI is served at https://<OPENCTI_HOST>.
OPENCTI_HOST=localhost
# Direct plain-HTTP port for local debugging. Keep 127.0.0.1 so only Caddy is exposed.
OPENCTI_BIND_ADDRESS=127.0.0.1
OPENCTI_HOST_PORT=8080
OPENCTI_ADMIN_EMAIL=admin@opencti.local
OPENCTI_ADMIN_PASSWORD=CHANGEME
# Must be a UUIDv4.
OPENCTI_ADMIN_TOKEN=CHANGEME
OPENCTI_HEALTHCHECK_ACCESS_KEY=CHANGEME
# 32 random bytes, base64 (openssl rand -base64 32).
OPENCTI_ENCRYPTION_KEY=CHANGEME
OPENCTI_NODE_MEMORY_MB=8096
OPENCTI_WORKER_REPLICAS=3

###########################
# CADDY (HTTPS)           #
###########################

# <your email>  -> Let's Encrypt certificate (OPENCTI_HOST must be a public DNS name
#                  pointing at this server, ports 80 and 443 reachable from the internet)
# internal      -> certificate from Caddy's own CA (IPs, localhost, internal hostnames)
CADDY_TLS=internal

###########################
# CONNECTORS (UUIDv4 each)#
###########################

CONNECTOR_EXPORT_FILE_STIX_ID=CHANGEME
CONNECTOR_EXPORT_FILE_CSV_ID=CHANGEME
CONNECTOR_EXPORT_FILE_TXT_ID=CHANGEME
CONNECTOR_IMPORT_FILE_STIX_ID=CHANGEME
CONNECTOR_IMPORT_DOCUMENT_ID=CHANGEME
CONNECTOR_IMPORT_FILE_YARA_ID=CHANGEME
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID=CHANGEME
CONNECTOR_ANALYSIS_ID=CHANGEME
CONNECTOR_OPENCTI_ID=CHANGEME
CONNECTOR_MITRE_ID=CHANGEME
CONNECTOR_CISA_KEV_ID=CHANGEME
CONNECTOR_ALIENVAULT_ID=CHANGEME

###########################
# THREAT FEEDS            #
###########################

# AlienVault OTX: free key from https://otx.alienvault.com (Settings -> API Integration).
# Leave empty to keep the connector off; after setting it, re-run ./setup.sh.
ALIENVAULT_API_KEY=
# First import goes back to this date (ISO 8601, UTC). setup.sh sets it to 30 days ago.
ALIENVAULT_PULSE_START_TIMESTAMP=
# Optional compose profiles; setup.sh adds "alienvault" when the key is set.
COMPOSE_PROFILES=
